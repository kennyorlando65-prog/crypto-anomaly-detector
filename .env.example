# Every value here is optional. The app runs with sensible defaults and no
# configuration at all.
#
# Vercel: set these in the dashboard for the project. On a single Services
# deployment nothing is required, because the dashboard calls the engine at
# /api on the same origin.
#
# Local development: copy the relevant lines into frontend/.env.local
# (frontend variables) or export them in the shell that runs the engine
# (backend variables).

# --- Frontend (frontend/.env.local) ----------------------------------------

# Where the dashboard looks for the detection engine.
# Leave unset on Vercel: the rewrite in vercel.json sends /api to the backend
# service, so same-origin /api is correct.
# Set it to the engine's own address when running the two halves separately:
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_API_BASE=

# --- Backend (shell environment when running the engine) -------------------

# CoinGecko keyless public API allows roughly 5 to 15 calls per minute.
# Raise this only if you have measured that your IP is allowed more.
COINGECKO_CALLS_PER_MINUTE=10

# Comma-separated CoinGecko ids to track. Defaults to 8 major assets.
# TRACKED_ASSETS=bitcoin,ethereum,solana

# Detector thresholds. Defaults are documented in the README.
# DETECTOR_WINDOW=30
# DETECTOR_WATCH_THRESHOLD=2.0
# DETECTOR_NOTABLE_THRESHOLD=3.0
# DETECTOR_EXTREME_THRESHOLD=4.0
# DETECTOR_VOLUME_THRESHOLD=2.5
# DETECTOR_VOLATILITY_RATIO_THRESHOLD=2.0
# DETECTOR_COOLDOWN=3
# DETECTOR_ROBUST=false
